import java.util.*;
public class Solution {
    public static void main(String[] args){
        Scanner sc=new Scanner(System.in);
        int n=sc.nextInt();
        int[] arr=new int[n];
        for(int i=0;i<n;i++){
            arr[i]=sc.nextInt();
        }
            int k=sc.nextInt();
            for(int i=1;i<n;i++){
                if(arr[i]%k!=arr[0]%k){
                    System.out.println(-1);
                    return;
                }
            }
            Arrays.sort(arr);
            int target=arr[n/2];
            long ops=0;
            for(int x:arr) ops+=Math.abs(x-target)/k;
            System.out.println(ops);
        }
    }
